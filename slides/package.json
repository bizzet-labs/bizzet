{
  "name": "@bizzet/slides",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md",
    "dev:en": "slidev slides.en.md --port 3031",
    "build": "slidev build slides.md --out dist",
    "build:en": "slidev build slides.en.md --out dist-en",
    "export": "slidev export slides.md --output slides.pdf",
    "export:en": "slidev export slides.en.md --output slides-en.pdf"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.63.0"
  }
}
