{
  "name": "@bizzet",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "dev": "pnpm --parallel -r run dev",
    "dev:docs": "pnpm --filter @bizzet/docs run dev",
    "dev:dashboard": "pnpm --filter @bizzet/dashboard run dev",
    "dev:wallet": "pnpm --filter @bizzet/wallet run dev",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @bizzet/db run generate",
    "db:migrate": "pnpm --filter @bizzet/db run migrate",
    "db:studio": "pnpm --filter @bizzet/db run studio",
    "db:seed": "pnpm --filter @bizzet/db run seed"
  },
  "engines": {
    "node": ">=20.0"
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "lefthook": "^2.1.14"
  }
}
